[Unit]
Description=Posttrain workstation cleanup (unused checkouts, images and caches; a week of build cache, models and scratch)
Documentation=file://%h/projects/rl/docs/operations/cleanup-playbook.md

[Service]
Type=oneshot
WorkingDirectory=%h/projects/rl
ExecStart=%h/.local/bin/uv run --no-sync python scripts/operations/cleanup_workstation.py --apply
Nice=19
IOSchedulingClass=idle
