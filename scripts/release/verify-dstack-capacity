#!/usr/bin/env bash
set -euo pipefail

# Release qualification intentionally uses an explicit named worker selected by
# the workflow's hardware profile. dstack's scheduler state does not include
# arbitrary host processes, so a generic memory-only target can select a machine
# whose GPU is already occupied.
dstack_bin="${POSTTRAIN_DSTACK_BIN:-/opt/posttrain-dstack-client/bin/dstack}"
output="${1:-.release/dstack-capacity.json}"
target_host="${POSTTRAIN_DSTACK_HOST:-carbonteq-ai-workstation.lan}"
minimum_gpu_memory_mib="${POSTTRAIN_DSTACK_MIN_GPU_MEMORY_MIB:-90112}"
max_attempts="${POSTTRAIN_DSTACK_CAPACITY_ATTEMPTS:-6}"
retry_seconds="${POSTTRAIN_DSTACK_CAPACITY_RETRY_SECONDS:-5}"

[[ -x "${dstack_bin}" ]] || {
  echo "dstack client is not executable: ${dstack_bin}" >&2
  exit 2
}
[[ "${max_attempts}" =~ ^[1-9][0-9]*$ ]] || {
  echo "POSTTRAIN_DSTACK_CAPACITY_ATTEMPTS must be a positive integer" >&2
  exit 2
}
[[ "${retry_seconds}" =~ ^[0-9]+$ ]] || {
  echo "POSTTRAIN_DSTACK_CAPACITY_RETRY_SECONDS must be a non-negative integer" >&2
  exit 2
}

mkdir -p "$(dirname "${output}")"
fleet_json="$(mktemp)"
fleet_stderr="$(mktemp)"
trap 'rm -f "${fleet_json}" "${fleet_stderr}"' EXIT

ready=false
failure_kind="unknown"
attempt=0
for attempt in $(seq 1 "${max_attempts}"); do
  : >"${fleet_json}"
  : >"${fleet_stderr}"
  if ! "${dstack_bin}" fleet get local-gpu-workers --json >"${fleet_json}" 2>"${fleet_stderr}"; then
    failure_kind="command_failed"
  elif ! jq -e 'type == "object" and (.instances | type == "array")' "${fleet_json}" >/dev/null 2>&1; then
    failure_kind="invalid_json"
  elif jq -e \
    --arg host "${target_host}" \
    --argjson minimum_gpu_memory_mib "${minimum_gpu_memory_mib}" \
    '
      .status == "active"
      and ([.instances[]
        | select(
            .hostname == $host
            and .status == "idle"
            and .health_status == "healthy"
            and (.unreachable // false) == false
            and .total_blocks == 1
            and (.instance_type.resources.gpus | length) == 1
            and .instance_type.resources.gpus[0].vendor == "nvidia"
            and .instance_type.resources.gpus[0].memory_mib >= $minimum_gpu_memory_mib
          )
      ] | length) == 1
    ' "${fleet_json}" >/dev/null; then
    ready=true
    break
  else
    failure_kind="target_not_ready"
  fi

  if [[ "${attempt}" -lt "${max_attempts}" ]]; then
    echo "dstack capacity retry: attempt=${attempt}/${max_attempts} reason=${failure_kind}" >&2
    sleep "${retry_seconds}"
  fi
done

if [[ "${ready}" != true ]]; then
  stdout_sha256="$(sha256sum "${fleet_json}" | awk '{print $1}')"
  stderr_sha256="$(sha256sum "${fleet_stderr}" | awk '{print $1}')"
  stdout_bytes="$(wc -c <"${fleet_json}")"
  stderr_bytes="$(wc -c <"${fleet_stderr}")"
  jq -n \
    --arg schema "carbonteq.dstack-release-capacity.v1" \
    --arg status "rejected" \
    --arg failure_kind "${failure_kind}" \
    --arg host "${target_host}" \
    --argjson minimum_gpu_memory_mib "${minimum_gpu_memory_mib}" \
    --argjson attempts "${attempt}" \
    --arg stdout_sha256 "${stdout_sha256}" \
    --arg stderr_sha256 "${stderr_sha256}" \
    --argjson stdout_bytes "${stdout_bytes}" \
    --argjson stderr_bytes "${stderr_bytes}" \
    '{
      schema: $schema,
      status: $status,
      failure_kind: $failure_kind,
      target_host: $host,
      minimum_gpu_memory_mib: $minimum_gpu_memory_mib,
      attempts: $attempts,
      response: {
        stdout_sha256: $stdout_sha256,
        stdout_bytes: $stdout_bytes,
        stderr_sha256: $stderr_sha256,
        stderr_bytes: $stderr_bytes
      }
    }' >"${output}"
  echo "dstack release target is not ready: host=${target_host} reason=${failure_kind} attempts=${attempt}" >&2
  if [[ "${failure_kind}" == "target_not_ready" ]]; then
    jq '{name,status,instances:[.instances[] | {hostname,status,health_status,unreachable,total_blocks,gpu:(.instance_type.resources.gpus[0] // null)}]}' "${fleet_json}" >&2
  fi
  exit 3
fi

jq \
  --arg schema "carbonteq.dstack-release-capacity.v1" \
  --arg host "${target_host}" \
  --argjson minimum_gpu_memory_mib "${minimum_gpu_memory_mib}" \
  '
    . as $fleet
    | ($fleet.instances[] | select(.hostname == $host)) as $instance
    | {
        schema: $schema,
        status: "accepted",
        fleet_id: $fleet.id,
        fleet_name: $fleet.name,
        fleet_status: $fleet.status,
        target_host: $host,
        minimum_gpu_memory_mib: $minimum_gpu_memory_mib,
        instance: {
          id: $instance.id,
          instance_num: $instance.instance_num,
          hostname: $instance.hostname,
          status: $instance.status,
          health_status: $instance.health_status,
          unreachable: $instance.unreachable,
          total_blocks: $instance.total_blocks,
          gpu: $instance.instance_type.resources.gpus[0],
          cpus: $instance.instance_type.resources.cpus,
          memory_mib: $instance.instance_type.resources.memory_mib,
          disk_mib: $instance.instance_type.resources.disk.size_mib
        }
      }
  ' "${fleet_json}" >"${output}"

echo "dstack release capacity passed: host=${target_host} receipt=${output}"
