#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: $0 VERSION REVISION OUTPUT_DIR" >&2
  exit 2
}

[[ $# -eq 3 ]] || usage
version="$1"
revision="$2"
repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
mkdir -p "$3"
output_dir="$(cd "$3" && pwd)"
stage_dir="${output_dir}/stage"
distribution_dir="${output_dir}/distributions"
bundle_dir="${output_dir}/wheelhouse"
build_cache_dir="${output_dir}/uv-cache"

[[ ! -e "$stage_dir" && ! -e "$distribution_dir" && ! -e "$bundle_dir" ]] || {
  echo "release output directory is not empty: $output_dir" >&2
  exit 1
}

target_version="$(uv run --no-sync posttrain-release check --repository-root "$repository_root" | sed -n 's/^authored version: release\/manifest.toml = //p')"
[[ -n "$target_version" ]] || { echo "could not read authored release version" >&2; exit 1; }

stage_args=("$stage_dir" --repository-root "$repository_root")
if [[ "$version" != "$target_version" ]]; then
  stage_args+=(--version "$version")
fi
uv run --no-sync posttrain-release stage "${stage_args[@]}"
# The runtime-image manifest is generated by the protected release workflow
# immediately before this script runs. Release staging intentionally uses
# `git archive` so arbitrary dirty checkout state cannot enter a wheelhouse,
# but this generated manifest is an explicit release input: the clean
# consumer and the OCI registry must describe the same image digests.
generated_image_manifest="${repository_root}/packages/runtime-images/src/posttrain/runtime_images/published.toml"
staged_image_manifest="${stage_dir}/packages/runtime-images/src/posttrain/runtime_images/published.toml"
if [[ -f "${generated_image_manifest}" && -f "${staged_image_manifest}" ]]; then
  cp "${generated_image_manifest}" "${staged_image_manifest}"
fi
mkdir -p "$distribution_dir" "$bundle_dir"
# The protected LAN runner sets UV_CACHE_DIR to a persistent, machine-owned
# cache. Keep the release-local fallback for ordinary local invocations, but do
# not throw away build metadata after every protected workflow.
build_cache_dir="${UV_CACHE_DIR:-$build_cache_dir}"
mkdir -p "$build_cache_dir"
(
  cd "$stage_dir"
  # The staged tree intentionally excludes the checkout's .venv. Pin the
  # build interpreter explicitly so a runner's system Python cannot change
  # PEP 517 behavior or select an incompatible interpreter.
  UV_CACHE_DIR="$build_cache_dir" uv build \
    --all-packages \
    --no-sources \
    --python 3.13 \
    --out-dir "$distribution_dir"
)
uv run --no-sync posttrain-release receipt "$distribution_dir" \
  --destination "${output_dir}/python-release-receipt.json" \
  --version "$version" \
  --revision "$revision" \
  --repository-root "$stage_dir"
uv run --no-sync posttrain-release receipt-check "${output_dir}/python-release-receipt.json" \
  --distribution-root "$distribution_dir"
cp "$distribution_dir"/* "$bundle_dir"/
cp "$stage_dir/docs/release-and-consumption.md" "$bundle_dir/README.md"
cp "$stage_dir/release/github-constraints.txt" "$bundle_dir/github-constraints.txt"
(
  cd "$bundle_dir"
  sha256sum ./*.whl ./*.tar.gz > SHA256SUMS
)
tarball="${output_dir}/posttrain-wheelhouse-${version}.tar.gz"
tar -czf "$tarball" -C "$bundle_dir" .
sha256sum "$tarball" > "${output_dir}/release-SHA256SUMS"
echo "built immutable Python distribution set: $version"
