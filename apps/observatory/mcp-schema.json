    {
      "description": "Render note Markdown for a run without saving it; check `unresolved` before adding the note.\n\nCite numbers through data blocks instead of typing them: a fenced block ```data <name>``` holding\n`measures: [...]`, `by: [...]`, `where: {...}`, `runs: [self, <run id>]` (names from describe_semantics),\nthen `{{<name>.<column>}}` inline, or a ```value```, ```table``` or ```chart``` block with `data: <name>`.\n`{{run.<dimension>}}` shows a setting of this run and `[[run:<id>]]` links another run.",
      "inputSchema": {
        "properties": {
          "body_md": {
            "title": "Body Md",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "run_id",
          "body_md"
        ],
        "title": "render_note_previewArguments",
        "type": "object"
      },
      "name": "render_note_preview",
      "outputSchema": {
        "additionalProperties": true,
        "title": "render_note_previewDictOutput",
        "type": "object"
      }
    },
    {
      "description": "Call this before query_semantics. Lists the dimensions, measures, metrics and SQL tables available for\nruns (a list of run ids, or run-dimension filters such as {\"run.work_package\": \"...\"}) or job kinds.",
      "inputSchema": {
        "properties": {
          "job_kinds": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
